[Unit]
Description=SeaweedFS Volume
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seaweedfs
Group=seaweedfs
LimitNOFILE=1000000
ExecStart=/usr/local/bin/weed volume \
  -master=192.168.47.21:9333,192.168.47.23:9333,192.168.47.25:9333 \
  -ip=<SUNUCU_IP_ADRESI> \
  -port=8080 \
  -dir=/data/volumes \
  -max=100 \
  -metricsPort=9325
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

